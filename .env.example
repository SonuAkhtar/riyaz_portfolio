# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored by Vite by default — never commit real secrets.

# Formspree form ID for the contact form.
# 1. Sign up at https://formspree.io
# 2. Create a new form, copy the ID from the endpoint URL
#    (e.g. https://formspree.io/f/xpzgawkr -> the ID is "xpzgawkr")
# 3. Paste it below.
VITE_FORMSPREE_ID=
